{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scene-factory.local/schemas/scene_spec.schema.json",
  "title": "SceneFactory recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "room_type",
    "room_dimensions_m",
    "event",
    "objects"
  ],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "room_type": {"type": "string", "minLength": 1},
    "room_dimensions_m": {"$ref": "#/$defs/vec3Positive"},
    "event": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/objectRequest"}
    },
    "task": {"type": "object"}
  },
  "$defs": {
    "vec2": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "minItems": 2,
      "maxItems": 2
    },
    "vec3": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "vec3Positive": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position"],
      "properties": {
        "position": {"$ref": "#/$defs/vec3"},
        "yaw_deg": {"type": "number"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": {"enum": ["near", "partly_occluded_by"]},
        "target": {"type": "string"},
        "min_distance_m": {"type": "number", "minimum": 0},
        "max_distance_m": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "objectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "category"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "asset_id": {"type": "string"},
        "support": {"type": "string"},
        "dynamic": {"type": "boolean"},
        "fixed_pose": {"$ref": "#/$defs/pose"},
        "yaw_range_deg": {"$ref": "#/$defs/vec2"},
        "region_xy": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 4,
          "maxItems": 4
        },
        "edge_bias": {"type": "boolean"},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}}
      },
      "anyOf": [{"required": ["fixed_pose"]}, {"required": ["support"]}]
    }
  }
}

