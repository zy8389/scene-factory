{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SceneFactory sampling plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "strata"],
  "properties": {
    "schema_version": {"const": "scene_factory.sampling_plan.v1"},
    "minimum_level": {"enum": ["layout", "physics", "task"], "default": "layout"},
    "strata": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "recipe", "quota", "candidate_count", "seed_start"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
          "recipe": {"type": "string", "minLength": 1},
          "quota": {"type": "integer", "minimum": 1},
          "candidate_count": {"type": "integer", "minimum": 1},
          "seed_start": {"type": "integer"},
          "filter": {
            "anyOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["object_id", "region_xy"],
                "properties": {
                  "object_id": {"type": "string", "minLength": 1},
                  "region_xy": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}
                }
              }
            ]
          }
        }
      }
    }
  }
}
