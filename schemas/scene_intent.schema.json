{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scene-factory.local/schemas/scene_intent.schema.json",
  "title": "SceneFactory semantic scene intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "room_type",
    "event",
    "description",
    "objects",
    "relations",
    "room_dimensions_m",
    "clutter_level",
    "layout_style"
  ],
  "properties": {
    "room_type": {"enum": ["kitchen", "living_room"]},
    "event": {"enum": ["after_cooking", "recent_snacking", "returned_home"]},
    "description": {"type": "string"},
    "room_dimensions_m": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "array",
          "items": {"type": "number", "exclusiveMinimum": 0},
          "minItems": 3,
          "maxItems": 3
        }
      ]
    },
    "clutter_level": {"type": "number", "minimum": 0, "maximum": 1},
    "layout_style": {"type": "string"},
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_id",
          "category",
          "dynamic",
          "support_hint",
          "attributes",
          "state"
        ],
        "properties": {
          "object_id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "category": {
            "enum": [
              "backpack",
              "coffee_table",
              "cushion",
              "cutting_board",
              "entry_bench",
              "keys",
              "kitchen_counter",
              "kitchen_island",
              "kitchen_knife",
              "mug",
              "pot",
              "pot_lid",
              "remote_control",
              "shoe",
              "side_cabinet",
              "snack_bag",
              "sofa",
              "tissue",
              "vegetable_bag"
            ]
          },
          "dynamic": {"type": "boolean"},
          "support_hint": {"type": ["string", "null"]},
          "attributes": {"type": "array", "items": {"type": "string"}},
          "state": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "predicate", "target"],
        "properties": {
          "subject": {"type": "string"},
          "predicate": {"enum": ["on", "near", "partly_occluded_by"]},
          "target": {"type": "string"}
        }
      }
    }
  }
}
