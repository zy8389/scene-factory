{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scene-factory.local/schemas/asset_record.schema.json",
  "title": "SceneFactory asset record",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_id", "category", "bbox_m", "mass_kg", "friction", "status"],
  "properties": {
    "asset_id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "bbox_m": {"$ref": "#/$defs/vec3Positive"},
    "primitive": {"enum": ["cube", "cylinder", "sphere"]},
    "color": {"$ref": "#/$defs/color"},
    "mass_kg": {"type": "number", "exclusiveMinimum": 0},
    "friction": {"type": "number", "minimum": 0},
    "support_surfaces": {
      "type": "array",
      "items": {"$ref": "#/$defs/supportSurface"}
    },
    "source_path": {"type": ["string", "null"]},
    "source_type": {"enum": ["primitive", "local_usd", "generated_usd"]},
    "collision_mode": {"enum": ["primitive", "authored", "proxy_box", "none"]},
    "qa_report_path": {"type": ["string", "null"]},
    "license": {"type": ["string", "null"]},
    "status": {"enum": ["quarantine", "validated", "rejected"]},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "vec2Positive": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "vec3": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "vec3Positive": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "color": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "supportSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "center", "size"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "center": {"$ref": "#/$defs/vec3"},
        "size": {"$ref": "#/$defs/vec2Positive"}
      }
    }
  }
}
