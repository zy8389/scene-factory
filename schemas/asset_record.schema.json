{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scene-factory.local/schemas/asset_record.schema.json",
  "title": "SceneFactory asset record",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_id", "category", "status"],
  "anyOf": [
    {"required": ["bbox_m", "mass_kg", "friction"]},
    {"required": ["usd_path", "mass", "friction"]}
  ],
  "properties": {
    "asset_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "source": {"type": ["string", "null"]},
    "license": {"type": ["string", "null"]},
    "hash": {"type": ["string", "null"]},
    "bbox_m": {"$ref": "#/$defs/vec3Positive"},
    "primitive": {"enum": ["cube", "cylinder", "sphere"]},
    "color": {"$ref": "#/$defs/color"},
    "mass_kg": {"type": "number", "exclusiveMinimum": 0},
    "mass": {"type": "number", "exclusiveMinimum": 0},
    "friction": {"type": "number", "minimum": 0},
    "support_surfaces": {
      "type": "array",
      "items": {"$ref": "#/$defs/supportSurface"}
    },
    "articulations": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/articulationJoint"}
    },
    "interaction_regions": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/interactionRegion"}
    },
    "interior_regions": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/interiorRegion"}
    },
    "semantic_states": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/semanticState"}
    },
    "source_path": {"type": ["string", "null"]},
    "usd_path": {"type": ["string", "null"]},
    "collision_path": {"type": ["string", "null"]},
    "collision_status": {"enum": ["not_provided", "pending", "authored", "provided", "validated", "rejected"]},
    "static_friction": {"type": "number", "minimum": 0},
    "dynamic_friction": {"type": "number", "minimum": 0},
    "rigid_body": {"type": "boolean"},
    "collision_enabled": {"type": "boolean"},
    "source_type": {"enum": ["primitive", "local_usd", "generated_usd"]},
    "collision_mode": {"enum": ["primitive", "authored", "proxy_box", "none"]},
    "qa_report_path": {"type": ["string", "null"]},
    "status": {"enum": ["raw", "normalized", "quarantine", "validated", "ready", "rejected"]},
    "qa_report": {"type": ["string", "null"]},
    "notes": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "grasp_region": {},
    "support_surface": {
      "oneOf": [
        {"$ref": "#/$defs/supportSurface"},
        {"type": "array", "items": {"$ref": "#/$defs/supportSurface"}}
      ]
    }
  },
  "$defs": {
    "vec2Positive": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "vec3": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "vec3Positive": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "color": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "supportSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "center", "size"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "center": {"$ref": "#/$defs/vec3"},
        "size": {"$ref": "#/$defs/vec2Positive"},
        "link": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "articulationJoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["joint_id", "joint_type", "parent", "child", "axis", "lower_limit", "upper_limit", "default_position"],
      "properties": {
        "joint_id": {"type": "string", "minLength": 1},
        "joint_type": {"enum": ["revolute", "prismatic"]},
        "parent": {"type": "string", "minLength": 1},
        "child": {"type": "string", "minLength": 1},
        "axis": {"$ref": "#/$defs/vec3"},
        "lower_limit": {"type": "number"},
        "upper_limit": {"type": "number"},
        "default_position": {"type": "number"}
      }
    },
    "interactionRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "kind", "link", "center", "size", "approach_axis", "allowed_actions"],
      "properties": {
        "region_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["handle", "grasp", "push", "pull", "button"]},
        "link": {"type": "string", "minLength": 1},
        "center": {"$ref": "#/$defs/vec3"},
        "size": {"$ref": "#/$defs/vec3Positive"},
        "approach_axis": {"$ref": "#/$defs/vec3"},
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["grasp", "pull", "push", "rotate", "lift"]}
        },
        "controlled_joint": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "interiorRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "link", "center", "size"],
      "properties": {
        "region_id": {"type": "string", "minLength": 1},
        "link": {"type": "string", "minLength": 1},
        "center": {"$ref": "#/$defs/vec3"},
        "size": {"$ref": "#/$defs/vec3Positive"}
      }
    },
    "semanticState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "joint", "range"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "joint": {"type": "string", "minLength": 1},
        "range": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}],
          "minItems": 2,
          "maxItems": 2
        },
        "target_position": {"type": ["number", "null"]}
      }
    }
  }
}
